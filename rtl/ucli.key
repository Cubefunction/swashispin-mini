fsdbDumpflush 
fsdbDumpvars 0 "simulator.RF_IO_GEN\[0\].DAC.nco_q"  +all +trace_process
fsdbDumpflush 
fsdbDumpvars 0 "simulator.RF_IO_GEN\[0\].DAC.o_vrf"  +all +trace_process
fsdbDumpflush 
if {[catch {ucliCore::setFocus tool}]} {}
fsdbDumpvars 0 "simulator.DCRFLI.BTN.i_clk"  +all +trace_process
fsdbDumpflush 
fsdbDumpvars 0 "simulator.DCRFLI.BTN.i_rst"  +all +trace_process
fsdbDumpflush 
fsdbDumpvars 0 "simulator.DCRFLI.BTN.i_btn\[0\]"  +all +trace_process
fsdbDumpflush 
fsdbDumpvars 0 "simulator.DCRFLI.BTN.w_btn_steady\[0\]"  +all +trace_process
fsdbDumpflush 
fsdbDumpvars 0 "simulator.DCRFLI.BTN.r_ff1\[0\]"  +all +trace_process
fsdbDumpflush 
fsdbDumpvars 0 "simulator.DCRFLI.BTN.r_ff2\[0\]"  +all +trace_process
fsdbDumpflush 
fsdbDumpvars 0 "simulator.DCRFLI.BTN.o_pressed\[0\]"  +all +trace_process
fsdbDumpflush 
if {[catch {ucliCore::setFocus tool}]} {}
run
synEnv::hasFataled
ucliCore::getToolPID
synEnv::isFinished
save::getUserdefinedProcs
if {[catch {ucliCore::setFocus tool}]} {}
fsdbDumpflush 
senv
synUtils::resolveSourceFilename sim/simulator2.sv
puts $::ucliCore::cbug_active
if {[catch {ucliCore::setFocus tool}]} {}
checkpoint -list -all
if {[catch {ucliCore::setFocus tool}]} {}
stop
if {[catch {ucliCore::setFocus tool}]} {}
run
synEnv::hasFataled
ucliCore::getToolPID
synEnv::isFinished
save::getUserdefinedProcs
if {[catch {ucliCore::setFocus tool}]} {}
fsdbDumpflush 
senv
synUtils::resolveSourceFilename sim/simulator2.sv
puts $::ucliCore::cbug_active
if {[catch {ucliCore::setFocus tool}]} {}
checkpoint -list -all
if {[catch {ucliCore::setFocus tool}]} {}
stop
if {[catch {ucliCore::setFocus tool}]} {}
finish; quit
