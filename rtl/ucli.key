fsdbDumpvars 0 "simulator.RF_IO_GEN\[0\].DAC.Q"  +all +trace_process
fsdbDumpflush 
fsdbDumpvars 0 "simulator.RF_IO_GEN\[0\].DAC.deg"  +all +trace_process
fsdbDumpflush 
fsdbDumpvars 0 "simulator.RF_IO_GEN\[0\].DAC.rad"  +all +trace_process
fsdbDumpflush 
